{
  "name": "downbit-local",
  "version": "1.1.3",
  "type": "module",
  "description": "A local-first media downloader with a web workspace and CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zc-RUC/downbit-local.git"
  },
  "homepage": "https://github.com/Zc-RUC/downbit-local#readme",
  "keywords": [
    "downloader",
    "media",
    "hls",
    "yt-dlp",
    "cli",
    "local-first"
  ],
  "bin": {
    "downbit": "./cli/downbit.js"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "postinstall": "node scripts/install-ytdlp.js",
    "cli": "node cli/downbit.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.64.0",
    "puppeteer-core": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.5"
  }
}
